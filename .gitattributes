# Auto-detect text files and normalize line endings
* text=auto

# Explicitly set JS/TS/CSS to LF
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary